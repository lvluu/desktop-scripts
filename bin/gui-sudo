#!/usr/bin/env bash
# gui-sudo CMD...: sudo that works from a menu launcher. PAM tries the fingerprint first (a popup says
# touch the sensor); on failure or timeout sudo asks for the password in a zenity popup (sudo -A).
# In a terminal it is plain sudo.
# One sudo call: without a tty sudo caches credentials per parent process, so a `sudo -v` first
# would not cover the command (it then fails with "a terminal is required").
set -euo pipefail
[ -t 0 ] && exec sudo "$@"
sudo -n true 2>/dev/null && exec sudo "$@"
zenity --info --no-wrap --title "Authentication" --timeout 15 \
  --text "Touch the fingerprint sensor to allow:\n$*\n\nThe password popup follows if it fails." 2>/dev/null &
export GUI_SUDO_HINT=$!
SUDO_ASKPASS="$(dirname "$(readlink -f "$0")")/zenity-askpass" sudo -A "$@"
