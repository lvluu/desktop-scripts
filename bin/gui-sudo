#!/usr/bin/env bash
# gui-sudo CMD...: sudo that works from a menu launcher. PAM tries the fingerprint first (a popup says
# touch the sensor); on failure or timeout sudo asks for the password in a gui-dialog popup (sudo -A).
# In a terminal it is plain sudo.
# One sudo call: without a tty sudo caches credentials per parent process, so a `sudo -v` first
# would not cover the command (it then fails with "a terminal is required").
set -euo pipefail
[ -t 0 ] && exec sudo "$@"
sudo -n true 2>/dev/null && exec sudo "$@"
BIN="$(dirname "$(readlink -f "$0")")"
"$BIN/gui-dialog" --info --title "Authentication" --timeout 15 \
  --text "Touch the fingerprint sensor to allow:"$'\n'"$*"$'\n\n'"The password popup follows if it fails." >/dev/null 2>&1 &
export GUI_SUDO_HINT=$!
SUDO_ASKPASS="$BIN/gui-askpass" sudo -A "$@"
