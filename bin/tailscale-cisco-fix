#!/usr/bin/env bash
# Let tailnet traffic through Cisco Secure Client's lockdown firewall.
# Cisco (vpnagentd) fills `ip filter` chain ciscovpn with a catch-all drop, plus explicit
# drops of port 53 on tailscale0, so tailnet TCP/DNS die while the VPN is up (UDP/DERP keep
# working, so `tailscale ping` still answers). Cisco rewrites its rules on every connect and
# also later on its own, with no interface event (2026-11-04: rules gone 25 min after a connect).
# Needs root. `sudo tailscale-cisco-fix --install` once (vpn-up does it on its first connect):
# copies this script to /usr/local/sbin and adds a systemd timer that reruns it every 30 s.
set -euo pipefail

if [[ ${1:-} == --install ]]; then
  install -m 755 "$0" /usr/local/sbin/tailscale-cisco-fix
  rm -f /etc/NetworkManager/dispatcher.d/90-tailscale-cisco # the earlier hook, connect-only
  cat >/etc/systemd/system/tailscale-cisco-fix.service <<'UNIT'
[Unit]
Description=Let tailnet traffic through Cisco Secure Client's firewall (desktop-scripts)
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tailscale-cisco-fix
StandardOutput=null
UNIT
  cat >/etc/systemd/system/tailscale-cisco-fix.timer <<'UNIT'
[Unit]
Description=Rerun tailscale-cisco-fix every 30 s (Cisco rewrites its rules at any time)
[Timer]
OnBootSec=30s
OnUnitActiveSec=30s
AccuracySec=5s
[Install]
WantedBy=timers.target
UNIT
  systemctl daemon-reload
  systemctl enable --now tailscale-cisco-fix.timer
  echo "installed: /usr/local/sbin/tailscale-cisco-fix and tailscale-cisco-fix.timer (every 30 s)"
fi

chain=ciscovpninitial
nft list chain ip filter "$chain" >/dev/null 2>&1 || { echo "no Cisco firewall chain; nothing to do"; exit 0; }

for dir in iifname oifname; do
  if nft list chain ip filter "$chain" | grep -q "$dir \"tailscale0\" .*accept"; then
    echo "$dir tailscale0: already allowed"
  else
    nft insert rule ip filter "$chain" "$dir" tailscale0 counter accept
    echo "$dir tailscale0: allowed"
  fi
done

# Cisco's tunnel MTU (cscotun0, ~1298) is too small for WireGuard packets of a 1280-byte
# tailscale0: inner packets over ~1210 bytes vanish (TLS ClientHello hangs, small SYNs pass).
# Clamp tailscale0 so the outer packet fits. tailscaled resets it on restart: rerun then.
cisco_mtu=$(ip -o link show cscotun0 2>/dev/null | sed -n 's/.* mtu \([0-9]*\).*/\1/p')
if [ -n "$cisco_mtu" ]; then
  want=$((cisco_mtu - 100))
  ip link set tailscale0 mtu "$want"
  echo "tailscale0 mtu: $want (cscotun0 $cisco_mtu)"
fi
